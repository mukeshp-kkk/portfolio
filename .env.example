# Email Configuration (Choose one: SMTP or Brevo API)

# Option 1: SMTP Configuration (e.g., Brevo SMTP)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-smtp-user
EMAIL_PASS=your-smtp-password
EMAIL_FROM=your-email@example.com

# Option 2: Brevo API Configuration
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=your-email@example.com
BREVO_SENDER_NAME=Your Name

# Contact form notifications (defaults to EMAIL_FROM / BREVO_SENDER_EMAIL)
CONTACT_NOTIFY_EMAIL=your-email@example.com

# Server Configuration
PORT=3000
NODE_ENV=production
